generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  owner
  admin
  member
  reviewer
}

enum SkillType {
  workflow
  template
  deployment
}

enum SkillScope {
  global
  organization
  workspace
  project
}

enum RunState {
  queued
  running
  needs_input
  needs_approval
  failed
  completed
  cancelled
}

enum ReviewStatus {
  pending
  passed
  failed
}

enum SkillReviewState {
  draft
  validated
  published
  deprecated
  archived
}

enum DeploymentStatus {
  pr_opened
  ci_running
  ci_passed
  ci_failed
  merged
  closed
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  workspaces    Workspace[]
  skillBindings SkillBinding[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Workspace {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  members        WorkspaceMember[]
  projects       Project[]
  skillBindings  SkillBinding[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}

model WorkspaceMember {
  id          String      @id @default(cuid())
  workspaceId String
  userId      String
  role        ProjectRole
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime    @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id                     String                    @id @default(cuid())
  workspaceId            String
  name                   String
  repository             String?
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id])
  members                ProjectMember[]
  briefs                 LPBrief[]
  versions               PageVersion[]
  tasks                  WorkbenchTask[]
  messages               WorkbenchMessage[]
  taskSnapshots          WorkbenchTaskSnapshot[]
  runs                   Run[]
  runEvents              RunEvent[]
  toolObservations       ToolObservation[]
  deployments            Deployment[]
  artifactWorkspaces     ArtifactWorkspace[]
  artifactWorkspaceFiles ArtifactWorkspaceFile[]
  agentHandoffs          AgentHandoff[]
  skillBindings          SkillBinding[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([workspaceId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model LPBrief {
  id            String                  @id @default(cuid())
  projectId     String
  title         String
  prompt        String
  data          Json
  project       Project                 @relation(fields: [projectId], references: [id])
  versions      PageVersion[]
  taskSnapshots WorkbenchTaskSnapshot[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([projectId])
}

model PageVersion {
  id                     String                    @id @default(cuid())
  projectId              String
  briefId                String
  artifactData           Json
  artifactWorkspaceId    String?
  findings               Json
  reviewStatus           ReviewStatus
  project                Project                   @relation(fields: [projectId], references: [id])
  brief                  LPBrief                   @relation(fields: [briefId], references: [id])
  artifacts              Artifact[]
  deployments            Deployment[]
  taskSnapshots          WorkbenchTaskSnapshot[]
  artifactWorkspaces     ArtifactWorkspace[]
  artifactWorkspaceFiles ArtifactWorkspaceFile[]
  createdAt              DateTime                  @default(now())

  @@index([projectId])
  @@index([briefId])
  @@index([reviewStatus])
}

model WorkbenchTask {
  id        String                   @id
  title     String
  type      String
  status    String
  projectId String?
  project   Project?                 @relation(fields: [projectId], references: [id])
  messages  WorkbenchMessage[]
  snapshot  WorkbenchTaskSnapshot?
  createdAt DateTime

  @@index([projectId])
  @@index([createdAt])
}

model WorkbenchMessage {
  id        String        @id
  taskId    String
  projectId String?
  role      String
  content   String
  task      WorkbenchTask @relation(fields: [taskId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])
  createdAt DateTime

  @@index([taskId, createdAt])
  @@index([projectId])
}

model WorkbenchTaskSnapshot {
  taskId        String         @id
  projectId     String
  briefId       String?
  pageVersionId String?
  task          WorkbenchTask  @relation(fields: [taskId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])
  brief         LPBrief?       @relation(fields: [briefId], references: [id])
  pageVersion   PageVersion?   @relation(fields: [pageVersionId], references: [id])
  createdAt     DateTime

  @@index([projectId])
  @@index([briefId])
  @@index([pageVersionId])
}

model ArtifactWorkspace {
  id            String                  @id
  projectId     String
  pageVersionId String?
  runId         String?
  kind          String
  state         String
  project       Project                 @relation(fields: [projectId], references: [id])
  pageVersion   PageVersion?            @relation(fields: [pageVersionId], references: [id])
  files         ArtifactWorkspaceFile[]
  createdAt     DateTime
  updatedAt     DateTime

  @@index([projectId, createdAt])
  @@index([pageVersionId])
  @@index([runId])
}

model ArtifactWorkspaceFile {
  id            String            @id
  workspaceId   String
  projectId     String
  pageVersionId String?
  path          String
  kind          String
  mimeType      String
  sizeBytes     Int
  sha256        String
  summary       String
  content       String
  workspace     ArtifactWorkspace @relation(fields: [workspaceId], references: [id])
  project       Project           @relation(fields: [projectId], references: [id])
  pageVersion   PageVersion?      @relation(fields: [pageVersionId], references: [id])
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([workspaceId, path])
  @@index([projectId])
  @@index([pageVersionId])
}

model Artifact {
  id            String      @id @default(cuid())
  pageVersionId String
  filename      String
  mimeType      String
  kind          String
  byteSize      Int
  checksum      String?
  storage       Json
  pageVersion   PageVersion @relation(fields: [pageVersionId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([pageVersionId, filename])
  @@index([pageVersionId, kind])
}

model MCPConnector {
  id        String    @id
  scope     SkillScope
  targetKey String
  name      String
  transport String
  config    Json
  enabled   Boolean   @default(true)
  tools     MCPTool[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([scope, targetKey])
  @@index([enabled])
}

model MCPTool {
  id               String       @id @default(cuid())
  connectorId      String
  name             String
  permission       String
  roles            String[]
  requiresApproval Boolean      @default(false)
  connector        MCPConnector @relation(fields: [connectorId], references: [id])
  createdAt        DateTime     @default(now())

  @@unique([connectorId, name])
  @@index([permission])
}

model ModelProvider {
  id        String               @id
  scope     SkillScope
  targetKey String
  name      String
  provider  String
  config    Json
  enabled   Boolean              @default(true)
  policies  ModelRoutingPolicy[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([scope, targetKey])
  @@index([provider, enabled])
}

model ModelRoutingPolicy {
  id         String        @id @default(cuid())
  scope      SkillScope
  targetKey  String
  role       String
  providerId String
  model      String
  fallback   Json?
  settings   Json?
  provider   ModelProvider @relation(fields: [providerId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([scope, targetKey, role])
  @@index([providerId])
}

model Skill {
  id        String         @id
  name      String
  type      SkillType
  scope     SkillScope
  versions  SkillVersion[]
  createdAt DateTime       @default(now())

  @@index([type, scope])
}

model SkillVersion {
  id          String           @id @default(cuid())
  skillId     String
  version     String
  manifest    Json
  content     String
  reviewState SkillReviewState
  skill       Skill            @relation(fields: [skillId], references: [id])
  bindings    SkillBinding[]
  createdAt   DateTime         @default(now())

  @@unique([skillId, version])
  @@index([skillId])
  @@index([reviewState])
}

model SkillBinding {
  id             String       @id @default(cuid())
  skillVersionId String
  scope          SkillScope
  targetKey      String
  organizationId String?
  workspaceId    String?
  projectId      String?
  enabled        Boolean      @default(true)
  settings       Json?
  skillVersion   SkillVersion @relation(fields: [skillVersionId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([skillVersionId, scope, targetKey])
  @@index([scope, targetKey])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([projectId])
}

model Run {
  id               String            @id
  projectId        String
  taskId           String?
  role             String
  state            RunState
  startedAt        DateTime
  completedAt      DateTime?
  contextSummary   Json
  project          Project           @relation(fields: [projectId], references: [id])
  events           RunEvent[]
  toolObservations ToolObservation[]
  outboundHandoffs AgentHandoff[]    @relation("AgentHandoffFromRun")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
  @@index([taskId])
  @@index([state])
  @@index([startedAt])
}

model RunEvent {
  id        String   @id
  runId     String
  projectId String
  taskId    String?
  sequence  Int
  type      String
  message   String
  payload   Json
  run       Run      @relation(fields: [runId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime

  @@unique([runId, sequence])
  @@index([runId, type])
  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
}

model ToolObservation {
  id            String   @id
  runId         String
  projectId     String
  taskId        String?
  toolName      String
  input         Json
  outputSummary String
  state         String
  exitCode      Int?
  errorName     String?
  project       Project  @relation(fields: [projectId], references: [id])
  run           Run      @relation(fields: [runId], references: [id])
  createdAt     DateTime
  completedAt   DateTime?

  @@index([runId])
  @@index([projectId])
  @@index([taskId])
  @@index([state])
  @@index([createdAt])
}

model AgentHandoff {
  id             String   @id
  projectId      String
  taskId         String?
  fromRunId      String
  fromRole       String
  toRole         String
  state          String
  summary        String
  blockingReason String?
  artifactRefs   Json?
  project        Project  @relation(fields: [projectId], references: [id])
  fromRun        Run      @relation("AgentHandoffFromRun", fields: [fromRunId], references: [id])
  createdAt      DateTime
  updatedAt      DateTime

  @@index([projectId, updatedAt])
  @@index([taskId])
  @@index([fromRunId])
  @@index([toRole])
  @@index([fromRole])
  @@index([state])
}

model Deployment {
  id             String      @id
  projectId      String
  pageVersionId  String
  branch         String
  commitSha      String
  pullRequestUrl String
  status         DeploymentStatus
  project        Project     @relation(fields: [projectId], references: [id])
  pageVersion    PageVersion @relation(fields: [pageVersionId], references: [id])
  createdAt      DateTime    @default(now())

  @@unique([pageVersionId])
  @@index([projectId])
  @@index([status])
}
