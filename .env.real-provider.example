# LP Engineering Team Agent real-provider local run template.
# Copy selected values into .env.local and fill API keys locally.
# Do not commit .env.local or any file containing real API keys.

# Real Web/API/runtime provider calls are opt-in.
REAL_MODEL_RUNTIME=1
# Local real provider model calls default to 120s per attempt; raise only for slow providers.
LP_AGENT_MODEL_PROVIDER_TIMEOUT_MS=120000

# Real provider integration tests remain opt-in separately.
REAL_MODEL_PROVIDER_TEST=0

# OpenAI Chat Completions compatible provider.
# In Web Models, use:
# api: openai-completions
# baseUrl: copy from OPENAI_COMPATIBLE_BASE_URL
# apiKeyEnv: OPENAI_COMPATIBLE_API_KEY
# model: copy from OPENAI_COMPATIBLE_DEFAULT_MODEL
OPENAI_COMPATIBLE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_DEFAULT_MODEL=glm-5.1

# Anthropic Messages compatible provider.
# In Web Models, use:
# api: anthropic-messages
# baseUrl: copy from ANTHROPIC_BASE_URL
# apiKeyEnv: ANTHROPIC_API_KEY
# model: copy from ANTHROPIC_DEFAULT_MODEL
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=glm-5.1
