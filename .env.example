# LP Engineering Team Agent environment template.
# Copy this file to .env.local and fill in secret values locally.
# Do not commit .env.local or any file containing real API keys.

# Real Web/API/runtime provider calls are opt-in. Keep this disabled for normal dev.
REAL_MODEL_RUNTIME=0

# Real provider integration tests are opt-in. Keep this disabled for normal tests.
REAL_MODEL_PROVIDER_TEST=0

# Anthropic Messages compatible provider.
# For Zhipu GLM Claude-compatible API, keep this base URL.
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=glm-5.1

# Optional Claude Code style model alias. Keep this when reusing Claude Code config.
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.1

# Optional Zhipu-specific aliases.
# If the Web Models view uses apiKeyEnv=ZHIPU_API_KEY, put the same key here instead.
ZHIPU_API_KEY=
ZHIPU_DEFAULT_MODEL=glm-5.1
